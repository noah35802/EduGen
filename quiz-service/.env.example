LLM_PROVIDER=groq
LLM_MODEL=replace-with-a-current-groq-model-id
GROQ_API_KEY=replace-with-your-groq-api-key
# Set the key for your chosen provider if using a provider other than Groq.
GEMINI_API_KEY=replace-with-your-gemini-api-key
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
# Must match backend QUIZ_SERVICE_API_KEY when authentication is enabled.
SERVICE_API_KEY=replace-with-a-long-random-secret
# Set to 1 to return fake questions without calling an LLM.
MOCK_LLM=0
MAX_UPLOAD_MB=25
MAX_CHUNKS_PER_QUIZ=12
LLM_DELAY_SECONDS=0
