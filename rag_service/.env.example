# ---- Chat LLM: Groq (free tier, no card) ----
# Get a key: https://console.groq.com/keys
LLM_API_KEY=gsk_...
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
# Faster / higher free limits, a bit lower quality: llama-3.1-8b-instant

# ---- Embeddings: local = free, runs on your machine ----
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Only if EMBEDDING_PROVIDER=openai:
# OPENAI_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small

# ---- Service ----
# Shared secret the main LMS sends in the X-API-Key header. Leave empty to disable (dev only).
SERVICE_API_KEY=change-me
CHROMA_DIR=./data/chroma
COLLECTION_NAME=lms_documents
SHARED_DOCS_DIR=./data/shared_docs

# ---- RAG tuning ----
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=6
MAX_UPLOAD_MB=20
MAX_HISTORY_TURNS=6
